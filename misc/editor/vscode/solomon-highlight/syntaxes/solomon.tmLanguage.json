{
    "scopeName": "solomon.injection",
    "injectionSelector": "L:source.c -comment -string, L:source.cpp -comment -string, L:source.fortran.free -comment -string, L:source.fortran.fixed -comment -string",
    "patterns": [
        {
            "name": "keyword.control.directive.solomon",
            "match": "\\b(?:SOLOMON|PRAGMA_ACC|PRAGMA_OMP|ACC_CLAUSE|OMP_CLAUSE|OMP_TARGET)_[A-Z0-9_]+\\b"
        },
        {
            "name": "keyword.control.directive.solomon",
            "match": "\\b(?:ACC|OMP)_PASS_LIST\\b"
        }
    ]
}
